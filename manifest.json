{
    "manifest_version": 3,
    "name": "Dreamlab Canvas",
    "version": "1.1",
    "description": "Capture images, links, and text into Dreamlab collections.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "contextMenus",
        "storage",
        "activeTab",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "https://dreamlab-canvas.vercel.app/*",
        "<all_urls>"
    ],
    "action": {
        "default_title": "Dreamlab Capture",
        "default_popup": "popup.html"
    },
    "options_page": "options.html",
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js",
                "floating-widget.js"
            ],
            "run_at": "document_end"
        }
    ],
    "commands": {
        "save-page": {
            "suggested_key": {
                "default": "Alt+Shift+S",
                "mac": "Alt+Shift+S"
            },
            "description": "Open Dreamlab capture launcher"
        }
    }
}
