{
    "manifest_version": 3,
    "name": "Dreamlab Canvas",
    "version": "1.1",
    "description": "Capture images, links, and text into Dreamlab collections.",
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    },
    "permissions": [
        "contextMenus",
        "storage",
        "activeTab",
        "tabs",
        "scripting"
    ],
    "host_permissions": [
        "https://dreamlab-canvas.vercel.app/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4173/*",
        "http://127.0.0.1:4173/*",
        "<all_urls>"
    ],
    "action": {
        "default_title": "Dreamlab Capture",
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_end",
            "all_frames": true
        }
    ],
    "commands": {
        "save-page": {
            "suggested_key": {
                "default": "Ctrl+Alt+S",
                "mac": "Command+Alt+S"
            },
            "description": "Save current page to Dreamlab"
        },
        "capture-visible": {
            "suggested_key": {
                "default": "Ctrl+Alt+Y",
                "mac": "Command+Alt+Y"
            },
            "description": "Open image capture review"
        },
        "capture-full-page": {
            "suggested_key": {
                "default": "Ctrl+Alt+P",
                "mac": "Command+Alt+P"
            },
            "description": "Capture full page screenshot"
        },
        "smart-picker": {
            "suggested_key": {
                "default": "Ctrl+Alt+I",
                "mac": "Command+Alt+I"
            },
            "description": "Pick an image or background from page"
        }
    }
}
